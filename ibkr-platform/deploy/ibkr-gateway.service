[Unit]
Description=IB Gateway (headless, managed by IBC)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=5

[Service]
Type=simple
Environment=TWS_MAJOR_VRSN=1045
Environment=IBC_INI=/opt/ibc/config.ini
Environment=IBC_PATH=/opt/ibc
Environment=TWS_PATH=/root/Jts
Environment=LOG_PATH=/var/log/ibc
Environment=HOME=/root
WorkingDirectory=/opt/ibc
ExecStartPre=/bin/mkdir -p /var/log/ibc
# xvfb-run owns the X server's lifetime and exports DISPLAY itself. The previous
# unit hard-coded DISPLAY=:99 and guarded startup with `pgrep -f "Xvfb :99"`,
# which matched the guard's own command line, so Xvfb was never actually started
# and IBC died with "Can't connect to X11 window server using ':99'".
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x1024x24" /opt/ibc/gatewaystart.sh -inline
# Gateway exits *cleanly* on its own schedule; on-failure left it down for 33
# hours once. The daily restart is Gateway's own AutoRestart (set through
# AutoRestartTime in /opt/ibc/config.ini) and never reaches systemd, so this
# only covers crashes. A missed 2FA push does not exit either
# (ReloginAfterSecondFactorAuthenticationTimeout=no): IBC waits at the expired
# prompt for an operator to press Start, and no further push is sent.
Restart=always
RestartSec=60
TimeoutStopSec=60
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
