# ── Storage ───────────────────────────────────────────────────────────────────
# One database, shared collections, a tenant_id on every tenant-owned document.
MONGODB_URI=mongodb://mongodb:27017
MONGODB_DATABASE=ibkr_rms_live
# Use a Redis database dedicated to this platform. Keys are namespaced per
# tenant (t:<tenant id>:…), but the platform still assumes the database is its own.
REDIS_URL=redis://redis:6379/0

# ── Web ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://sattvic-rms.ekalonsolutions.com
COOKIE_SECURE=false
WEB_PORT=3000

# Encrypts broker secrets held in MongoDB — today, SnapTrade user secrets.
# Generate one with `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Rotating it invalidates every stored secret, which then has to be re-issued.
# IBKR passwords are never stored in the database, so they are unaffected.
SECRET_KEY=

# ── Bootstrap tenant ──────────────────────────────────────────────────────────
# `python -m app.migrate` moves a pre-tenancy installation onto this tenant.
BOOTSTRAP_TENANT_SLUG=saatvik
BOOTSTRAP_TENANT_NAME=Saatvik

# ── Adopting an existing single-gateway install ───────────────────────────────
# Read only by `python -m app.migrate`, to register the gateway this host is
# already running as the bootstrap tenant's connection. Nothing else reads
# them: a connection's own document is the source of truth for where it
# connects and which unit and config file belong to it.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=17
IBKR_ACCOUNT=
IBC_CONFIG_PATH=/opt/ibc/config.ini
IBC_LOG_DIRECTORY=/opt/ibc/logs
GATEWAY_LAUNCHER_LOG=
GATEWAY_SERVICE=ibkr-gateway.service

# ── Automated gateway provisioning ────────────────────────────────────────────
# Adding an IB Gateway connection allocates a free port, writes that instance's
# own IBC config and launcher, and installs the templated systemd unit.
GATEWAY_PROVISIONING_ENABLED=true
GATEWAY_INSTANCE_ROOT=/opt/ibc/instances
GATEWAY_INSTANCE_UNIT=ibkr-gateway@{instance}.service
# An existing IBC config.ini to copy. Its credentials are never inherited; a new
# instance's login fields start blank. `gatewaystart.sh` must sit beside it.
GATEWAY_TEMPLATE_CONFIG=/opt/ibc/config.ini
GATEWAY_LOG_ROOT=/var/log/ibc
GATEWAY_PORT_RANGE_START=4100
GATEWAY_PORT_RANGE_END=4199

# ── SnapTrade (optional) ──────────────────────────────────────────────────────
# Leave blank to keep the provider unavailable. With these set, a tenant can be
# onboarded by sending the client a hosted-consent link instead of provisioning
# a gateway and handling their IBKR password.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
SNAPTRADE_REDIRECT_URI=
SNAPTRADE_POLL_SECONDS=60

# ── Massive market data (optional) ────────────────────────────────────────────
# The underlying reference price the payoff & risk panel models from. Leave the
# key blank to keep the feed off. Massive has priority for configured symbols;
# if it has no quote, the curve falls back to IB's option-model underlying price.
# Same vendor and API-key scheme as the
# US-Trading-Infra project. A key for files.massive.com (the flat-file product,
# an access key/secret pair) is a different credential and will not work here.
#
# ENTITLEMENTS THIS NEEDS. Massive is Polygon rebranded and gates by plan, so a
# valid key is not enough. Measured against the free tier on 2026-09-10:
#   403  /v3/snapshot/indices          — every index price, so no SPX at all
#   403  /v3/snapshot/options/{UL}     — chain snapshots
#   403  /v2/snapshot/.../tickers/{UL} — live stock snapshot
#   403  any I:SPX aggregate, and any data dated today ("data timeframe")
#   403  websockets, on socket. and delayed. alike, all three markets
#   200  /v2/aggs/{STOCK}/prev, /v1/open-close — end-of-day, yesterday or older
# End-of-day equity bars cannot price live risk, so an index underlying needs a
# plan carrying Indices plus real-time (or delayed) snapshots before this is
# worth turning on. Until then the panel is correct to stay on IB's mark.
MASSIVE_API_KEY=
MASSIVE_REST_URL=https://api.massive.com
# Comma-separated, US-listed so USD. Cash indices resolve via their I: ticker.
MASSIVE_UNDERLYINGS=SPX
MASSIVE_REFRESH_SECONDS=15
MASSIVE_IDLE_SECONDS=60
MASSIVE_ARCHIVE_DIRECTORY=/var/lib/ibkr-rms/market-data
MASSIVE_SESSION_TIMEZONE=America/New_York
MASSIVE_SESSION_OPEN=09:30
MASSIVE_SESSION_CLOSE=16:00

# ── Account history ───────────────────────────────────────────────────────────
# Two sources feed the performance curve. Snapshots are what this platform
# records itself, every SNAPSHOT_SECONDS, starting the moment the worker runs —
# `ibkr_accounts` is replaced in place on each update, so without these there is
# no history at all. Flex backfills the broker's own daily net liquidation from
# before that, and is the only way to get depth on day one.
SNAPSHOT_SECONDS=300
SNAPSHOT_RETENTION_DAYS=1095
# IBKR Flex Web Service. Create a Flex Query in Account Management that includes
# "Net Asset Value" / EquitySummaryByReportDateInBase, then take its query id and
# a Flex token from Reporting → Settings. Blank leaves the curve starting at the
# first snapshot. Backfill is triggered by an admin from the Performance panel,
# never automatically: IBKR rate-limits statement generation hard.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# ── Login and two-factor visibility ───────────────────────────────────────────
TWO_FACTOR_TIMEOUT_SECONDS=180
TWO_FACTOR_GRACE_SECONDS=30
GATEWAY_CONNECT_STALE_SECONDS=90
GATEWAY_LOGIN_POLL_SECONDS=5
